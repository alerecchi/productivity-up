{
  "name": "bucket-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "pnpm typecheck && vite build",
    "build:staging": "pnpm typecheck && CLOUDFLARE_ENV=staging CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "build:production": "pnpm typecheck && CLOUDFLARE_ENV=production CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build",
    "typecheck": "tsc --noEmit",
    "serve": "vite preview",
    "deploy:staging": "node --env-file-if-exists=.env.deploy.local scripts/deploy-staging.mjs",
    "deploy:production": "node --env-file-if-exists=.env.deploy.local scripts/deploy-production.mjs",
    "db:migrate:development": "node --env-file=.env.local --env-file-if-exists=.env.deploy.local scripts/migrate-development.mjs",
    "db:setup-staging-smoke-account": "node --env-file=.env.deploy.local scripts/setup-staging-smoke-account.mjs",
    "cf:typegen": "CLOUDFLARE_ENV=staging CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --include-runtime false && oxfmt worker-configuration.d.ts",
    "seed": "tsx scripts/seed.ts",
    "verify": "tsx scripts/verify/cli.ts",
    "test": "vitest run",
    "test:staging-email": "node --env-file=.env.deploy.local --env-file-if-exists=.env.cloudflare-setup.local scripts/test-staging-email.mjs",
    "test:public-contract": "vitest run --config vitest.public-contract.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "oxfmt && eslint --fix",
    "check": "oxfmt --check . && eslint",
    "validate": "pnpm check && pnpm test && pnpm test:public-contract && pnpm build:production"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/react": "^0.5.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-query-devtools": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.3",
    "@tanstack/router-plugin": "^1.168.47",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.4",
    "drizzle-seed": "^0.3.1",
    "lucide-react": "^1.59.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.34.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@playwright/test": "^1.64.1",
    "@tanstack/eslint-config": "^0.3.4",
    "@tanstack/eslint-plugin-query": "^5.104.4",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^27.4.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.36.0",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.1.12",
    "web-vitals": "^5.3.0",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
