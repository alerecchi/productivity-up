{
  "name": "bucket-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "tsc --noEmit && vite build",
    "build:staging": "CLOUDFLARE_ENV=staging CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build && tsc --noEmit",
    "build:production": "CLOUDFLARE_ENV=production CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false vite build && tsc --noEmit",
    "serve": "vite preview",
    "deploy:staging": "node --env-file-if-exists=.env.deploy.local scripts/deploy-staging.mjs",
    "deploy:production": "node --env-file-if-exists=.env.deploy.local scripts/deploy-production.mjs",
    "db:migrate:development": "node --env-file=.env.local --env-file-if-exists=.env.deploy.local scripts/migrate-development.mjs",
    "db:setup-staging-smoke-account": "node --env-file=.env.deploy.local scripts/setup-staging-smoke-account.mjs",
    "cf:typegen": "CLOUDFLARE_ENV=staging CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false wrangler types --include-runtime false && oxfmt worker-configuration.d.ts",
    "seed": "tsx scripts/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint",
    "format": "oxfmt && eslint --fix",
    "check": "oxfmt --check . && eslint"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/react": "^0.5.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.9.13",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-form-devtools": "^0.2.34",
    "@tanstack/react-form-start": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-query-devtools": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/react-router-ssr-query": "^1.167.2",
    "@tanstack/react-start": "^1.168.49",
    "@tanstack/router-plugin": "^1.168.35",
    "better-auth": "^1.7.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "drizzle-seed": "^0.3.1",
    "lucide-react": "^0.562.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.25.0",
    "shadcn": "^3.8.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.4",
    "@tanstack/eslint-config": "^0.3.4",
    "@tanstack/eslint-plugin-query": "^5.102.8",
    "@tanstack/eslint-plugin-router": "^1.162.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^27.4.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.36.0",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-plugin-checker": "^0.12.0",
    "vitest": "^4.1.11",
    "web-vitals": "^5.3.0",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.13.1+sha512.b2fc7683b8a6525414e7d13e1ba28caaddde96bf66ec540bfaeb7e702b81f3e0be4d1f295edf7f9fe0396740a8dce4509c582ddf79891f4543fea32d37645f25"
}
